# LLM Provider Configuration (Deterministic offline mode works when LLM_API_KEY is blank)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Authentication & Demo Mode
AUTH_DEMO_MODE=true
APP_ENV=development
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ai-pair-programmer
KEYCLOAK_CLIENT_ID=pair-programmer-client

# Server Configuration
HOST=127.0.0.1
PORT=8000
